<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lab.zhang.data_science.metrics_mall.mapper.MetricDimensionRelMapper">

    <!-- Update by primary key, updating non-null fields except primary key -->
    <update id="updateByPrimaryKey">
        UPDATE y
        <set>
            <if test="rel.isHot != null">
                is_hot = #{rel.isHot},
            </if>
            <if test="rel.validation != null">
                validation = #{rel.validation},
            </if>
        </set>
        WHERE mid = #{rel.metricMetaId}
        AND did = #{rel.dimensionId}
    </update>

</mapper>